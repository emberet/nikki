# Nikki local development. Never commit real credentials or wallet key files.
APP_URL=http://127.0.0.1:4900
DATABASE_URL="file:./dev.db"
SESSION_SECRET=
HELD_DIR=./held

# Founder studio is private; public Cloudflare export has no upload API.
RELEASE_MODE=founder
FOUNDER_WALLET=FcRL7KJYC1h1HLMbwZELZftxkZFAg4v5cgAKNqfFfiUC
UPLOADS_ENABLED=true

# Solana read-only RPC. Must support a complete finalized getProgramAccounts snapshot.
RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Planned token; live voting remains off until the real mint and X are ready.
TOKEN_MINT=
VOTING_ENABLED=false
# SHA-256 of the undisclosed treasury's base58 public address; server-only.
TREASURY_WALLET_HASH=

# X developer application, user authentication enabled.
# Callback: APP_URL/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Separate public operational payment recipient, NEVER the private treasury.
PAYMENT_WALLET=
# Separate storage signer with PREPAID Turbo credits; no automatic top-ups.
STORAGE_KEYPAIR_PATH=
# Explicit operational switch, leave off until live acceptance tests are authorized.
PUBLISHING_ENABLED=false

# Public creator accounts use Cloudflare D1 (see wrangler.jsonc).
# Public X callback: https://nikki.run/api/creators/auth/x/callback
# Enable creator transactions only after RPC and X setup are validated.
TOKEN_LAUNCH_ENABLED=false

# Public creator Worker RPC; keep provider API keys server-side.
CREATOR_RPC_URL=
