# Solana
RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Treasury: receives upload fees, pays Irys + refunds. Path to a solana keypair json.
TREASURY_KEYPAIR_PATH=./treasury.json
NEXT_PUBLIC_TREASURY_WALLET=
# Platform token (pump.fun mint). Leave empty to disable token payments/gates.
NEXT_PUBLIC_TOKEN_MINT=
TOKEN_MINT=
# Comma-separated wallet addresses with mod access
MOD_WALLETS=
# Session encryption (32+ chars)
SESSION_SECRET=
# Storage margin multiplier over raw Irys price (1.5 = 50% margin)
FEE_MARGIN=1.5
# Flat processing fee kept on rejection, in lamports (0.002 SOL)
REJECTION_FEE_LAMPORTS=2000000
# Held uploads dir
HELD_DIR=./held
# Min token balance to upload (base units). 0 = no gate.
UPLOAD_GATE_MIN=0
# Curator reward per review (token base units)
REVIEW_REWARD=0
